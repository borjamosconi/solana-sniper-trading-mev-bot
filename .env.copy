# Wallet
PRIVATE_KEY=

# Connection
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed

# Bot
LOG_LEVEL=trace
ONE_TOKEN_AT_A_TIME=true
PRE_LOAD_EXISTING_MARKETS=false
CACHE_NEW_MARKETS=false
# default or warp or jito
TRANSACTION_EXECUTOR=default
# if using default executor, fee below will be applied
COMPUTE_UNIT_LIMIT=101337
COMPUTE_UNIT_PRICE=421197
# if using warp or jito executor, fee below will be applied
CUSTOM_FEE=0.006
# LIVE_TRADING must be true to broadcast real transactions. When false, dry-run is forced.
LIVE_TRADING=false
# if true, bot will simulate and log trades without sending transactions
DRY_RUN=true
# cap concurrent open positions tracked by the bot
MAX_OPEN_POSITIONS=3
# max share of estimated quote capital for a single buy (percent)
MAX_POSITION_PERCENT=2.5
# rolling 24h realized loss vs starting capital snapshot that trips the kill switch
MAX_DAILY_LOSS_PERCENT=10
# set true ONCE then restart to clear a tripped kill switch; set back to false afterward
RESET_KILL_SWITCH=false
# max successful Raydium buys per UTC day
MAX_DAILY_RAYDIUM_BUYS=20
# max total SOL spent by pump.fun buys per UTC day
MAX_DAILY_PUMPFUN_BUY_SOL=0.05

# Buy
QUOTE_MINT=WSOL
QUOTE_AMOUNT=0.001
AUTO_BUY_DELAY=0
MAX_BUY_RETRIES=10
BUY_SLIPPAGE=20

# Sell
AUTO_SELL=true
MAX_SELL_RETRIES=10
AUTO_SELL_DELAY=0
PRICE_CHECK_INTERVAL=2000
PRICE_CHECK_DURATION=600000
TAKE_PROFIT=40
STOP_LOSS=20
SELL_SLIPPAGE=20

# Filters
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=30000

# Pump.fun
ENABLE_RAYDIUM=true
ENABLE_PUMP_FUN=false
PUMP_FUN_BUY_AMOUNT_SOL=0.001
# skip buy when bonding curve already progressed beyond this % (0-100)
PUMP_FUN_MAX_CURVE_PROGRESS=50
FILTER_CHECK_DURATION=60000
FILTER_CHECK_INTERVAL=2000
CONSECUTIVE_FILTER_MATCHES=3
CHECK_IF_MUTABLE=false
CHECK_IF_SOCIALS=true
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=false
CHECK_IF_BURNED=true
MIN_POOL_SIZE=5
MAX_POOL_SIZE=50
# reject/wait until pool is at least this many seconds old (poolOpenTime vs now)
MIN_POOL_AGE_SECONDS=30
CHECK_TOP_HOLDER=true
MAX_TOP_HOLDER_PERCENT=20

# Modern execution
DYNAMIC_PRIORITY_FEE=true
PRIORITY_FEE_MULTIPLIER=1.3
MAX_COMPUTE_UNIT_PRICE=5000000
SIMULATE_BEFORE_SEND=true
SKIP_PREFLIGHT=true

# Jupiter smart routing (lite-api needs no key; paid key goes on api.jup.ag)
ENABLE_JUPITER_SELL=true
ENABLE_JUPITER_COPY_BUY=true
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# Exit strategy
TRAILING_STOP=12
TRAILING_STOP_ACTIVATION=20
TAKE_PROFIT_SELL_PERCENT=100
BUY_COOLDOWN_MS=60000

# Risk
CIRCUIT_BREAKER_MAX_FAILURES=4
CIRCUIT_BREAKER_PAUSE_MS=300000
# Decision audit log: logs/decisions.jsonl (gitignored)
# Kill-switch state: .bot-state/daily-loss.json (gitignored)

# Telegram alerts (optional). Never commit real token/chat id.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Copy trade (comma-separated wallet addresses)
ENABLE_COPY_TRADE=false
COPY_WALLETS=

# Cross-DEX arbitrage (Jupiter dex-restricted quotes)
ENABLE_ARBITRAGE=false
ARB_INTERVAL_MS=2500
ARB_AMOUNT_SOL=0.05
ARB_MIN_PROFIT_BPS=40
ARB_SLIPPAGE_BPS=50
ARB_MAX_DAILY_SOL=0.25
ARB_PAIRS=SOL/USDC,SOL/USDT
ARB_DEX_GROUP_A=Raydium,Raydium CLMM,Raydium CPMM
ARB_DEX_GROUP_B=Whirlpool,Meteora DLMM,Meteora,Pump.fun Amm
